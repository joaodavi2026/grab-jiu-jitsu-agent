# Chave da API do Google Gemini (obtida em https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Modelo do Gemini utilizado pelo agente (não altere sem necessidade)
GEMINI_MODEL=gemini-3.1-flash-lite

# Quantidade máxima de mensagens guardadas no histórico de cada contato
MAX_HISTORICO_MENSAGENS=20

# Senha do dashboard administrativo (http://localhost:3000). Escolha uma
# senha sua — sem ela definida, o dashboard não inicia (o agente de WhatsApp
# continua funcionando normalmente).
DASHBOARD_PASSWORD=

# Porta onde o dashboard fica disponível
DASHBOARD_PORT=3000
